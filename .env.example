# Copy to .env.local. Only these NEXT_PUBLIC_ variables are allowed (AD-24).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STORAGE_ORIGIN=
# Server only, never prefixed NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# production and development use the schema public; a preview deployment uses APP_ENV=preview and a
# throwaway schema named preview_* (docs/environments.md). A mismatch disables the admin.
APP_ENV=development
SUPABASE_DB_SCHEMA=public
