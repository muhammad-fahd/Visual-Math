    "katex": "0.19.1",
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
