{
  "schemaVersion": 1,
  "id": "geo-cylinder-fill",
  "path": {
    "category": "geometry",
    "subcategory": "solids-volume",
    "chapter": "cylinders"
  },
  "chapterOrder": 1,
  "level": "intermediate",
  "estimatedMinutes": 10,
  "prerequisites": ["geo-cylinder-net"],
  "title": {
    "en": "Filling a Cylinder",
    "ur": "بیلن کو بھرنا"
  },
  "summary": {
    "en": "Pour liquid into a cylinder and see how much of its volume it fills.",
    "ur": "بیلن میں مائع ڈالیں اور دیکھیں کہ وہ اس کے حجم کا کتنا حصہ بھرتا ہے۔"
  },
  "goal": {
    "en": "See that one cone of liquid fills a third of a cylinder with the same base and height.",
    "ur": "دیکھیں کہ ایک مخروط جتنا مائع اسی قاعدے اور اونچائی والے بیلن کا ایک تہائی بھرتا ہے۔"
  },
  "tags": {
    "en": [
      "cylinder",
      "fill",
      "volume",
      "one third"
    ],
    "ur": [
      "بیلن",
      "بھرنا",
      "حجم",
      "ایک تہائی"
    ]
  },
  "parameters": [
    {
      "id": "r",
      "label": {
        "en": "Radius",
        "ur": "رداس"
      },
      "kind": "number",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "default": 3,
      "unit": "cm"
    },
    {
      "id": "h",
      "label": {
        "en": "Height",
        "ur": "اونچائی"
      },
      "kind": "number",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 5,
      "unit": "cm"
    },
    {
      "id": "lvl",
      "label": {
        "en": "Level",
        "ur": "سطح"
      },
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.33,
      "unit": "none"
    }
  ],
  "derived": [
    {
      "id": "vol",
      "expr": "pi * r^2 * h * lvl"
    },
    {
      "id": "cone",
      "expr": "pi * r^2 * h / 3"
    }
  ],
  "scene": {
    "type": "solid3d",
    "v": 1,
    "caption": {
      "en": "A cylinder with liquid in it. The level is shown as a share of the volume.",
      "ur": "ایک بیلن جس میں مائع ہے۔ سطح کو حجم کے حصے کے طور پر دکھایا گیا ہے۔"
    },
    "description": {
      "en": "A see-through cylinder with liquid inside. The liquid rises as you pour. One third of the way up holds as much as a cone of the same base and height.",
      "ur": "ایک شفاف بیلن جس کے اندر مائع ہے۔ ڈالنے پر مائع اوپر آتا ہے۔ ایک تہائی اونچائی پر اتنا مائع ہوتا ہے جتنا اسی قاعدے اور اونچائی کے مخروط میں۔"
    },
    "solid": {
      "kind": "cylinder",
      "dims": {
        "radius": "r",
        "height": "h"
      }
    },
    "labels": {
      "dimensions": false
    },
    "camera": {
      "preset": "iso"
    },
    "fill": {
      "level": "lvl"
    },
    "readouts": [
      {
        "id": "liquid",
        "label": {
          "en": "Liquid (cm³)",
          "ur": "مائع (cm³)"
        },
        "expr": "vol",
        "decimals": 1
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "title": {
        "en": "An empty cylinder",
        "ur": "خالی بیلن"
      },
      "body": {
        "en": "The cylinder is empty.",
        "ur": "بیلن خالی ہے۔"
      },
      "sceneState": {
        "params": {
          "lvl": 0
        }
      }
    },
    {
      "id": "s2",
      "title": {
        "en": "Pour one cone",
        "ur": "ایک مخروط ڈالیں"
      },
      "body": {
        "en": "One cone of liquid fills one third.",
        "ur": "ایک مخروط جتنا مائع ایک تہائی بھرتا ہے۔"
      },
      "formulaRefs": [
        "f1"
      ],
      "sceneState": {
        "params": {
          "lvl": 0.33
        }
      }
    },
    {
      "id": "s3",
      "title": {
        "en": "Pour three cones",
        "ur": "تین مخروط ڈالیں"
      },
      "body": {
        "en": "Three cones fill the cylinder.",
        "ur": "تین مخروط بیلن بھر دیتے ہیں۔"
      },
      "formulaRefs": [
        "f1"
      ],
      "sceneState": {
        "params": {
          "lvl": 1
        }
      }
    }
  ],
  "formulas": [
    {
      "id": "f1",
      "latex": "V_{\\text{cone}} = \\tfrac{1}{3} \\pi r^2 h = {{c}}\\ \\text{cm}^3",
      "caption": {
        "en": "A cone is a third of a cylinder",
        "ur": "مخروط بیلن کا ایک تہائی ہے"
      },
      "bind": {
        "c": {
          "expr": "cone",
          "decimals": 1
        }
      },
      "checks": [
        {
          "at": {
            "r": 3,
            "h": 5,
            "lvl": 0
          },
          "expect": {
            "c": 47.1
          }
        }
      ]
    }
  ],
  "example": {
    "title": {
      "en": "A third of a cylinder",
      "ur": "بیلن کا ایک تہائی"
    },
    "problem": {
      "en": "A cylinder has radius {{a}} cm and height {{b}} cm. How much liquid is in it when it is a third full?",
      "ur": "ایک بیلن کا رداس {{a}} سینٹی میٹر اور اونچائی {{b}} سینٹی میٹر ہے۔ ایک تہائی بھرا ہو تو اس میں کتنا مائع ہے؟"
    },
    "inputs": [
      {
        "id": "a",
        "label": {
          "en": "Radius",
          "ur": "رداس"
        },
        "min": 1,
        "max": 6,
        "step": 0.5,
        "default": 3,
        "unit": "cm"
      },
      {
        "id": "b",
        "label": {
          "en": "Height",
          "ur": "اونچائی"
        },
        "min": 1,
        "max": 10,
        "step": 0.5,
        "default": 5,
        "unit": "cm"
      }
    ],
    "lines": [
      {
        "text": {
          "en": "The whole cylinder holds pi r squared times h.",
          "ur": "پورا بیلن پائی r مربع ضرب h رکھتا ہے۔"
        },
        "math": "V = \\pi \\times {{a}}^2 \\times {{b}} = {{full}}",
        "calc": {
          "name": "full",
          "expr": "pi * a^2 * b",
          "decimals": 1,
          "expect": 141.4
        }
      },
      {
        "text": {
          "en": "A third of it is the liquid.",
          "ur": "اس کا ایک تہائی مائع ہے۔"
        },
        "math": "\\tfrac{1}{3} \\times {{full}} = {{third}}",
        "calc": {
          "name": "third",
          "expr": "full / 3",
          "decimals": 1,
          "expect": 47.1
        }
      }
    ],
    "answer": {
      "text": {
        "en": "There are about {{third}} cubic centimetres of liquid.",
        "ur": "تقریباً {{third}} مکعب سینٹی میٹر مائع ہے۔"
      },
      "math": "V \\approx {{third}}\\ \\text{cm}^3"
    }
  },
  "tryThis": [
    {
      "en": "Pour until the level reads one third. What is the liquid's volume?",
      "ur": "سطح ایک تہائی ہونے تک ڈالیں۔ مائع کا حجم کیا ہے؟"
    },
    {
      "en": "Make the cylinder taller. Does a third still match a cone?",
      "ur": "بیلن کو اونچا کریں۔ کیا ایک تہائی اب بھی مخروط کے برابر ہے؟"
    }
  ],
  "watchOut": {
    "en": "The cone must have the same base and height as the cylinder.",
    "ur": "مخروط کا قاعدہ اور اونچائی بیلن جیسی ہونی چاہیے۔"
  }
}
