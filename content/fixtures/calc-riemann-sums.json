  "title": {
    "en": "Riemann Sums and the Integral",
    "ur": "ریمان مجموعے اور تکمل"
  },
  "summary": {
    "en": "Cut the area under y = x squared into more and more slices and watch the sum close in on 9.",
    "ur": "y = x² کے نیچے رقبے کو زیادہ سے زیادہ ٹکڑوں میں کاٹیں اور دیکھیں کہ مجموعہ 9 کے قریب آتا ہے۔"
  },
  "goal": {
    "en": "See that the sums of thin slices approach the exact area under a curve.",
    "ur": "دیکھیں کہ پتلے ٹکڑوں کے مجموعے منحنی کے نیچے اصل رقبے کے قریب آتے ہیں۔"
  },
  "tags": {
    "en": [
      "integral",
      "Riemann sum",
      "area",
      "rectangles"
    ],
    "ur": [
      "تکمل",
      "ریمان مجموعہ",
      "رقبہ",
      "مستطیل"
    ]
  },
  "parameters": [
    {
      "id": "n",
      "label": {
        "en": "Number of slices",
        "ur": "ٹکڑوں کی تعداد"
      },
      "kind": "integer",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 3,
      "unit": "none"
    }
  ],
  "derived": [
    {
      "id": "w",
      "expr": "3 / n"
    },
    {
      "id": "ls",
      "expr": "w * sum(i, 0, n - 1, (i * w)^2)"
    },
    {
      "id": "rs",
      "expr": "w * sum(i, 1, n, (i * w)^2)"
    },
    {
      "id": "ms",
      "expr": "w * sum(i, 0, n - 1, ((i + 0.5) * w)^2)"
    },
    {
      "id": "ts",
      "expr": "(ls + rs) / 2"
    }
  ],
  "scene": {
    "type": "canvas2d",
    "v": 1,
    "caption": {
      "en": "The area under y = x squared from 0 to 3, cut into slices.",
      "ur": "0 سے 3 تک y = x² کے نیچے رقبہ، ٹکڑوں میں کٹا ہوا۔"
    },
    "description": {
      "en": "A parabola rising from the origin. The area under it from 0 to 3 is shaded, and thin slices stand on the axis. With few slices there are gaps or overlaps between the slices and the curve; with many they hug it.",
      "ur": "مبدا سے اٹھتا ہوا مکافی۔ 0 سے 3 تک اس کے نیچے رقبہ سایہ دار ہے، اور پتلے ٹکڑے محور پر کھڑے ہیں۔ کم ٹکڑوں میں ٹکڑوں اور منحنی کے درمیان خالی جگہ یا اوورلیپ ہوتا ہے؛ زیادہ ہوں تو وہ اس سے چپک جاتے ہیں۔"
    },
