  "steps": [
    {
      "id": "s1",
      "title": {
        "en": "Left rectangles",
        "ur": "بائیں مستطیل"
      },
      "body": {
        "en": "Cut the interval into slices and stand a rectangle on each, as high as the curve at its left side. The rectangles stay under the curve.",
        "ur": "وقفے کو ٹکڑوں میں کاٹیں اور ہر ایک پر مستطیل کھڑا کریں، جس کی اونچائی اس کے بائیں سرے پر منحنی جتنی ہو۔ مستطیل منحنی کے نیچے رہتے ہیں۔"
      },
      "formulaRefs": [
        "f1"
      ],
      "sceneState": {
        "params": {
          "n": 3
        },
        "hide": [
          "right",
          "mid",
          "trap"
        ]
      }
    },
    {
      "id": "s2",
      "title": {
        "en": "Right rectangles",
        "ur": "دائیں مستطیل"
      },
      "body": {
        "en": "Use the height at the right side instead. Now the rectangles stick out above the curve, and the sum is too big.",
        "ur": "اس کے بجائے دائیں سرے کی اونچائی لیں۔ اب مستطیل منحنی کے اوپر نکلتے ہیں، اور مجموعہ بہت بڑا ہے۔"
      },
      "sceneState": {
        "hide": [
          "left"
        ],
        "show": [
          "right"
        ]
      }
    },
    {
      "id": "s3",
      "title": {
        "en": "Midpoint and trapezoids",
        "ur": "درمیانی نقطہ اور ذوزنقے"
      },
      "body": {
        "en": "The height in the middle, or a slanted top, fits the curve better. The sum is already close to 9.",
        "ur": "درمیان کی اونچائی، یا ترچھی چھت، منحنی سے بہتر بیٹھتی ہے۔ مجموعہ پہلے ہی 9 کے قریب ہے۔"
      },
      "sceneState": {
        "hide": [
          "right"
        ],
        "show": [
          "mid"
        ]
      }
    },
    {
      "id": "s4",
      "title": {
        "en": "Many slices",
        "ur": "بہت سے ٹکڑے"
      },
      "body": {
        "en": "Make n large. Every sum closes in on the exact area, 9: that number is the integral.",
        "ur": "n بڑا کریں۔ ہر مجموعہ اصل رقبے، یعنی 9، کے قریب آتا ہے: وہ عدد تکمل ہے۔"
      },
      "formulaRefs": [
        "f2"
      ],
      "sceneState": {
        "params": {
          "n": 40
        },
        "hide": [
          "mid"
        ],
