        ]
      }
    }
  ],
  "formulas": [
    {
      "id": "f1",
      "latex": "\\Delta x = \\frac{3 - 0}{n} = {{d}}",
      "caption": {
        "en": "The width of a slice",
        "ur": "ٹکڑے کی چوڑائی"
      },
      "bind": {
        "d": {
          "expr": "w",
          "decimals": 3
        }
      },
      "checks": [
        {
          "at": {
            "n": 6
          },
          "expect": {
            "d": 0.5
          }
        },
        {
          "at": {
            "n": 3
          },
          "expect": {
            "d": 1
          }
        }
      ]
    },
    {
      "id": "f2",
      "latex": "\\int_0^3 x^2\\,dx = \\frac{3^3}{3} = {{v}}",
      "caption": {
        "en": "The exact area",
        "ur": "اصل رقبہ"
      },
      "bind": {
        "v": {
          "expr": "3^3 / 3",
          "decimals": 0
        }
      },
      "checks": [
        {
          "at": {
            "n": 1
          },
          "expect": {
            "v": 9
          }
        }
      ]
    },
    {
      "id": "f3",
      "latex": "L = {{l}},\\ R = {{r}},\\ M = {{m}},\\ T = {{t}}",
      "caption": {
        "en": "The four sums",
        "ur": "چاروں مجموعے"
      },
      "bind": {
        "l": {
          "expr": "ls",
          "decimals": 2
        },
        "r": {
          "expr": "rs",
          "decimals": 2
        },
        "m": {
          "expr": "ms",
          "decimals": 2
        },
        "t": {
          "expr": "ts",
          "decimals": 2
        }
      },
      "checks": [
        {
          "at": {
            "n": 3
          },
          "expect": {
            "l": 5,
            "r": 14,
            "m": 8.75,
            "t": 9.5
          }
        }
      ]
    }
  ],
  "example": {
    "title": {
      "en": "A left sum",
      "ur": "ایک بائیں مجموعہ"
    },
    "problem": {
      "en": "Estimate the area under y = x squared from 0 to 3 with {{m}} left rectangles of width 3 over {{m}}.",
      "ur": "{{m}} بائیں مستطیلوں سے، جن کی چوڑائی 3 تقسیم {{m}} ہے، 0 سے 3 تک y = x² کے نیچے رقبے کا اندازہ لگائیں۔"
    },
    "inputs": [
      {
        "id": "m",
        "label": {
          "en": "Slices",
          "ur": "ٹکڑے"
        },
        "min": 1,
        "max": 12,
        "step": 1,
        "default": 3,
        "unit": "none"
      }
    ],
    "lines": [
      {
        "text": {
          "en": "The width of each slice is 3 divided by the number of slices.",
          "ur": "ہر ٹکڑے کی چوڑائی 3 تقسیم ٹکڑوں کی تعداد ہے۔"
        },
        "math": "\\Delta x = 3 / {{m}} = {{dx}}",
        "calc": {
          "name": "dx",
          "expr": "3 / m",
          "decimals": 3,
          "expect": 1
        }
      },
      {
        "text": {
          "en": "Add the heights at the left sides, squared, and multiply by the width.",
          "ur": "بائیں سروں کی اونچائیاں، مربع کر کے، جمع کریں اور چوڑائی سے ضرب دیں۔"
        },
        "math": "\\Delta x \\times (0^2 + \\dots) = {{total}}",
        "calc": {
          "name": "total",
          "expr": "dx * sum(i, 0, m - 1, (i * dx)^2)",
          "decimals": 3,
          "expect": 5
        }
      }
    ],
    "answer": {
      "text": {
        "en": "The left sum is {{total}}; the exact area is 9.",
        "ur": "بائیں مجموعہ {{total}} ہے؛ اصل رقبہ 9 ہے۔"
      },
      "math": "L \\approx {{total}}"
    }
  },
  "tryThis": [
    {
      "en": "Set n to 1, then 3, then 40. How far is each sum from 9?",
      "ur": "n کو 1، پھر 3، پھر 40 کریں۔ ہر مجموعہ 9 سے کتنا دور ہے؟"
    },
    {
      "en": "Which sum is closest to 9 for the same n?",
      "ur": "ایک ہی n کے لیے کون سا مجموعہ 9 کے سب سے قریب ہے؟"
    }
  ],
  "watchOut": {
    "en": "A sum with few slices is only an estimate: the exact area comes from letting the slices get thinner and thinner.",
    "ur": "کم ٹکڑوں والا مجموعہ صرف اندازہ ہے: اصل رقبہ ٹکڑوں کو پتلے سے پتلا کرنے سے ملتا ہے۔"
  }
}
