          "at": {
            "angle": 60
          },
          "expect": {
            "c": 0.5
          }
        }
      ]
    },
    {
      "id": "f3",
      "latex": "\\sin^2\\theta + \\cos^2\\theta = 1",
      "identity": {
        "lhs": "sin(rad(angle))^2 + cos(rad(angle))^2",
        "rhs": "1"
      }
    }
  ],
  "example": {
    "title": {
      "en": "Find sine and cosine at an angle",
      "ur": "کسی زاویے پر سائن اور کوسائن معلوم کریں"
    },
    "problem": {
      "en": "A point sits at {{a}} degrees on the unit circle. Find its height and width.",
      "ur": "اکائی دائرے پر ایک نقطہ {{a}} ڈگری پر ہے۔ اس کی اونچائی اور چوڑائی معلوم کریں۔"
    },
    "inputs": [
      {
        "id": "a",
        "label": {
          "en": "Angle",
          "ur": "زاویہ"
        },
        "min": 0,
        "max": 360,
        "step": 1,
        "default": 30,
        "unit": "deg"
      }
    ],
    "lines": [
      {
        "text": {
          "en": "The height is the sine of the angle.",
          "ur": "اونچائی زاویے کا سائن ہے۔"
        },
        "math": "\\sin {{a}}^\\circ = {{h}}",
        "calc": {
          "name": "h",
          "expr": "sin(rad(a))",
          "decimals": 4,
          "expect": 0.5
        }
      },
      {
        "text": {
          "en": "The width is the cosine of the angle.",
          "ur": "چوڑائی زاویے کا کوسائن ہے۔"
        },
        "math": "\\cos {{a}}^\\circ = {{w}}",
        "calc": {
          "name": "w",
          "expr": "cos(rad(a))",
          "decimals": 4,
          "expect": 0.866
        }
      }
    ],
    "answer": {
      "text": {
        "en": "Height {{h}}, width {{w}}.",
        "ur": "اونچائی {{h}}، چوڑائی {{w}}۔"
      }
    }
  },
  "tryThis": [
    {
      "en": "Drag the point to 90 degrees. What is the width?",
      "ur": "نقطے کو 90 ڈگری پر لے جائیں۔ چوڑائی کیا ہے؟"
    },
    {
      "en": "Find two angles where the sine is 0.5.",
      "ur": "دو ایسے زاویے تلاش کریں جن کا سائن 0.5 ہو۔"
    }
  ],
  "watchOut": {
    "en": "Sine is the height, not the distance along the circle.",
    "ur": "سائن اونچائی ہے، دائرے کے ساتھ فاصلہ نہیں۔"
  },
