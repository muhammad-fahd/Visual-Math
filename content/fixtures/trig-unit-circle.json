  "formulas": [
    {
      "id": "f1",
      "latex": "\\sin\\theta = {{s}}",
      "caption": {
        "en": "Sine of the angle",
        "ur": "زاویے کا سائن"
      },
      "bind": {
        "s": {
          "expr": "sin(rad(angle))",
          "decimals": 4
        }
      },
      "checks": [
        {
          "at": {
            "angle": 30
          },
          "expect": {
            "s": 0.5
          }
        },
        {
          "at": {
            "angle": 150
          },
          "expect": {
            "s": 0.5
          }
        }
      ]
    },
    {
      "id": "f2",
      "latex": "\\cos\\theta = {{c}}",
      "caption": {
        "en": "Cosine of the angle",
        "ur": "زاویے کا کوسائن"
      },
      "bind": {
        "c": {
          "expr": "cos(rad(angle))",
          "decimals": 4
